import React, { useEffect } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';
import InputCrudFloatingUC from '@features/crud/components/InputCrudFloatingUC';
import { useProductCrud } from '../../product/hooks/useProductCrud';

// 1. Define tu esquema de validación con Zod
const schema = z.object({
  nombre: z.string().min(3, "El nombre debe tener al menos 3 caracteres"),
  email: z.string().email("Formato de email inválido"),
  descripcion: z.string().optional().or(z.literal("")),
});

// Inferir el tipo de datos automáticamente


function FormContainer() {
  // 2. Configura el formulario con el resolver de Zod
  const methods = useForm({
    resolver: zodResolver(schema),
    defaultValues: {
      nombre: '',
      email: '',
      descripcion: ''
    },
    mode: "onChange" 
  });

  const { handleSubmit, control, trigger, reset } = methods;

  const { setFormData, formData, handleChange, crudMode, isDisabledField,
  editableFields, handleEnableEdit, currentItem } = useProductCrud();

  const onSubmit = (data) => {
    console.log("Datos válidos:", data);
    setFormData(data)
    // Lógica de guardado
  };


  useEffect(() => {
    if (currentItem) {
      reset(currentItem); 
    }
  }, [currentItem, reset]);


  return (
    <FormProvider {...methods}>
      <form onSubmit={handleSubmit(onSubmit)} className="p-4 border rounded">
        <h4>Formulario de Ejemplo</h4>

        <InputCrudFloatingUC
          name="name"
          label="Product Name"
          control={control}
          isLocked={isDisabledField.name}
          onUnlock={handleEnableEdit}
        />

        <div className="d-flex gap-2 flex-column flex-lg-row">
          <InputCrudFloatingUC
            name={"brand"}
            label={"Brand"}
            control={control}
            isLocked={isDisabledField.brand}
            onUnlock={handleEnableEdit}
          />
          
          <InputCrudFloatingUC
            name={"sku"}
            label={"Sku"}
            control={control}
            isLocked={isDisabledField.sku}
            onUnlock={handleEnableEdit}
          />
        </div>


        <InputCrudFloatingUC
          name="email"
          label="Correo Electrónico"
          type="email"
          control={control}
          isLocked={isDisabledField.email}
          onUnlock={handleEnableEdit}
        />

{/*        <InputCrudFloating
          name="descripcion"
          label="Descripción"
          as="textarea"
          control={control}
          isLocked={false}
        />
*/}



        <InputCrudFloatingUC
          name={"weight"}
          label={"Weight (kg)"}
          isLocked={isDisabledField.weight}
          onUnlock={handleEnableEdit}
        />


        <div className="mt-3">
          <button type="submit" className="btn btn-primary">
            Guardar
          </button>
          <button type="button" className="btn btn-secondary ms-2" onClick={() => trigger()}>
            Forzar Validación
          </button>
        </div>
      </form>
    </FormProvider>
    );
}

export default FormContainer;